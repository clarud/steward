# Optional local application-data directory. This directory is not created in Phase 0.
# STEWARD_DATA_DIR=.steward

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
# STEWARD_LOG_LEVEL=INFO

# Model provider for `steward ask`. Gemini is the default.
STEWARD_MODEL_PROVIDER=gemini

# Copy the value from Google AI Studio. Keep this file private; never commit .env.
GEMINI_API_KEY=

# Change this if your Gemini account uses a different available model.
STEWARD_GEMINI_MODEL=gemini-3.5-flash

# Optional OpenAI alternative.
# STEWARD_MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# STEWARD_OPENAI_MODEL=

# Optional local Ollama alternative for `steward ask` and `steward agent`.
# Install Ollama separately, pull a tool-capable model, then select it here.
# STEWARD_MODEL_PROVIDER=local
# STEWARD_LOCAL_MODEL=qwen3
# STEWARD_LOCAL_MODEL_URL=http://127.0.0.1:11434

# Telegram bot token from BotFather. Required only for `steward telegram`.
TELEGRAM_BOT_TOKEN=

# Optional comma-separated Telegram chat IDs. When set, all other chats are
# rejected at the transport boundary before they reach Steward.
# STEWARD_TELEGRAM_ALLOWED_CHAT_IDS=
