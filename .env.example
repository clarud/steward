# Copy to .env and fill in. Keep .env private; never commit it.

# Where Steward keeps its database, logs, and backups.
# STEWARD_DATA_DIR=.steward

# Where Telegram uploads are saved, listed in INBOX.md.
# STEWARD_INBOX_DIR=vault/inbox

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
# STEWARD_LOG_LEVEL=INFO

# Model for Find, Ask, and Summarize. Gemini is the default (needs the `gemini` extra).
# The model sees retrieved snippets of your files; use `local` to keep them on this machine.
STEWARD_MODEL_PROVIDER=gemini
GEMINI_API_KEY=
STEWARD_GEMINI_MODEL=gemini-3.5-flash

# Optional OpenAI alternative.
# STEWARD_MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# STEWARD_OPENAI_MODEL=

# Optional NUS SoCLaaS alternative (OpenAI-compatible). `STEWARD_SOCLAAS_*`
# aliases are also accepted.
# STEWARD_MODEL_PROVIDER=soclaas
SOCLAAS_API_KEY=
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_MODEL=

# Optional local Ollama alternative. Install Ollama separately and pull a model.
# STEWARD_MODEL_PROVIDER=local
# STEWARD_LOCAL_MODEL=qwen3
# STEWARD_LOCAL_MODEL_URL=http://127.0.0.1:11434

# Telegram bot token from BotFather. Required only for `steward telegram`.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs allowed to use the bot. Strongly recommended:
# when set, every other chat is rejected before it reaches Steward.
# STEWARD_TELEGRAM_ALLOWED_CHAT_IDS=
